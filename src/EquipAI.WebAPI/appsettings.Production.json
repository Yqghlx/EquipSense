{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=equipai;Username=postgres;Password=SET_VIA_ENVIRONMENT"
  },
  "Redis": {
    "ConnectionString": "redis:6379,password=SET_VIA_ENVIRONMENT"
  },
  "AutoMapper": {
    "LicenseKey": "SET_VIA_ENVIRONMENT"
  },
  "Mqtt": {
    "Host": "mosquitto",
    "Port": 8883,
    "UseTls": true,
    "AllowUntrustedCertificates": false,
    "CaCertificatePath": "/etc/equipai/mqtt-certs/ca.crt"
  },
  "FileStorage": {
    "Provider": "Local",
    "BasePath": "/app/uploads",
    "S3": {
      "Region": "us-east-1",
      "KeyPrefix": "attachments"
    }
  },
  "Jwt": {
    "Issuer": "EquipAI",
    "Audience": "EquipAI-Web"
  },
  "Cors": {
    "Origins": []
  },
  "Gateway": {
    "Id": "SET_VIA_ENVIRONMENT",
    "TenantId": "SET_VIA_ENVIRONMENT",
    "Host": "edgegateway",
    "HealthPort": 8081,
    "AllowedHosts": [
      "edgegateway"
    ]
  },
  "Evaluation": {
    "AllowGroundTruthIngestion": false
  },
  "Security": {
    "Waf": {
      "Enabled": true,
      "RulesPath": "/etc/equipai/waf/rules.json",
      "RequireExternalRules": true,
      "ReloadDebounceMilliseconds": 250
    },
    "CertificateMonitoring": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "Certificates": {
        "nginx_tls": "/etc/equipai/tls/cert.pem",
        "mqtt_server": "/etc/equipai/mqtt-certs/server.crt",
        "mqtt_ca": "/etc/equipai/mqtt-certs/ca.crt"
      }
    },
    "Mfa": {
      "RequiredRoles": [
        "SystemAdmin",
        "MaintenanceLead"
      ]
    },
    "OutboundHttp": {
      "AllowPrivateNetworks": false
    }
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": "00:01:00",
    "AuthPermitLimit": 10,
    "TenantPermitLimit": 1000
  },
  "EmailDelivery": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "LeaseSeconds": 60,
    "MaxAttempts": 5,
    "MaxBackoffSeconds": 300,
    "RetentionDays": 90
  },
  "EventBus": {
    "Provider": "RabbitMQ",
    "AllowInMemoryInProduction": false
  }
}
