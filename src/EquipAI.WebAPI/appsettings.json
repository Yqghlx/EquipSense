{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=equipai_dev;Username=postgres;Password=SET_VIA_USER_SECRETS;Maximum Pool Size=100",
    "ReadOnly": "Host=localhost;Port=5432;Database=equipai_dev;Username=postgres;Password=SET_VIA_USER_SECRETS;Maximum Pool Size=100"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Secret": "SET_VIA_USER_SECRETS",
    "Issuer": "EquipAI",
    "Audience": "EquipAI",
    "AccessTokenMinutes": 15
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientIdPrefix": "equipai-backend",
    "TopicPattern": "factory/+/telemetry/+",
    "ReconnectDelaySeconds": 30,
    "UseTls": false,
    "AllowUntrustedCertificates": false,
    "CaCertificatePath": ""
  },
  "SignalR": {
    "HubPath": "/hubs/industrial",
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutIntervalSeconds": 30
  },
  "Llm": {
    "ApiKey": "",
    "ModelId": "qwen-plus",
    "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "TimeoutSeconds": 30
  },
  "Gateway": {
    "AuthKey": "SET_VIA_USER_SECRETS",
    "DefaultGatewayId": "gateway-001"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "FromEmail": "",
    "FromName": "EquipSense",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "EventBus": {
    "Provider": "InMemory",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest",
      "HeartbeatSeconds": 30,
      "AutomaticRecoveryEnabled": true,
      "PrefetchCount": 50,
      "HandlerTimeoutSeconds": 120,
      "MaxRetryCount": 5,
      "RetryIntervalSeconds": 30
    }
  },
  "AllowedHosts": "*",
  "Retention": {
    "AuditLogDays": 365,
    "NotificationDays": 90
  }
}
