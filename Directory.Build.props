<!-- Directory.Build.props — 全局共享构建设置 -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 暂时抑制 NuGet 警告：NU1603 版本自动解析、NU1901/NU1903 已知漏洞 -->
    <NoWarn>NU1603;NU1901;NU1903</NoWarn>
  </PropertyGroup>
</Project>
