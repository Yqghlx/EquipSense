<!-- Directory.Build.props — 全局共享构建设置 -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 仅保留已评估的版本自动解析提示；依赖漏洞警告必须进入构建门禁。 -->
    <NoWarn>NU1603</NoWarn>
  </PropertyGroup>
</Project>
