# 阶段1：构建
FROM node:22-alpine AS build
WORKDIR /app

# 先复制依赖文件（利用 Docker 层缓存）
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# 复制源码并构建
COPY frontend/ ./
RUN npm run build

# 阶段2：运行
FROM nginx:alpine AS runtime

# 复制自定义 Nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx-entrypoint.sh /docker-entrypoint.d/40-envsubst.sh
RUN chmod +x /docker-entrypoint.d/40-envsubst.sh

# 复制构建产物
COPY --from=build /app/dist /usr/share/nginx/html

# =============================================================================
# 安全加固：让 nginx 以非 root 用户（uid 101）运行
# nginx:alpine 镜像自带 nginx 用户（uid=101，gid=101）。master 进程绑定 443
# 端口的权限问题，通过 docker-compose 的 sysctls:
#   net.ipv4.ip_unprivileged_port_start=443
# 解决（让任何用户都能绑定 ≥443 的端口），无需 cap_add=NET_BIND_SERVICE。
#
# 需要把 nginx 运行期会写入的目录所有权交给 nginx 用户，否则非 root 启动会失败：
#   - /etc/nginx/conf.d：entrypoint 的 envsubst 会 mv 写入 default.conf
#   - /var/cache/nginx：client body / proxy / fastcgi temp 文件
#   - /var/run：nginx.pid 进程号文件
# =============================================================================
RUN chown -R nginx:nginx /etc/nginx/conf.d /var/cache/nginx /var/run /usr/share/nginx/html

# 切换到非 root 用户（与 backend/edgegateway 的 equipai 用户对齐，符合最小权限原则）
USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
