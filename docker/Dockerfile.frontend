# 阶段1：构建
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /app

# 先复制依赖文件（利用 Docker 层缓存）
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# 复制源码并构建
COPY frontend/ ./
RUN npm run build

# 阶段2：运行
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runtime

# 入口脚本需要解析证书主题，显式安装 openssl，避免证书安全检查静默失效。
RUN apk add --no-cache openssl

# 复制自定义 Nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx-entrypoint.sh /docker-entrypoint.d/40-envsubst.sh
RUN chmod +x /docker-entrypoint.d/40-envsubst.sh

# 复制构建产物
COPY --from=build /app/dist /usr/share/nginx/html

# =============================================================================
# 安全加固：Nginx master 仅以 root 身份完成低端口绑定，worker 通过 nginx.conf
# 中的 user nginx 指令降权为 nginx 用户运行。这样既保留 80→443 重定向，又不让
# 整个 Web 服务以 root 身份处理请求。
#
# 需要分别设置 Nginx master 和 worker 的运行目录权限：
#   - /etc/nginx/conf.d：root master 的 entrypoint 会用 envsubst 替换模板
#   - /var/cache/nginx：nginx worker 写入 client body / proxy / fastcgi 临时文件
#   - /var/run：root master 写入 nginx.pid 进程号文件
# =============================================================================
RUN chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html \
    && chown root:root /etc/nginx/conf.d /etc/nginx/conf.d/default.conf

# 保持 master 为 root，以便在丢弃全部其他 capability 的前提下绑定 80/443；
# worker 会由 Nginx 按配置自动降权为 nginx 用户。
USER root

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
