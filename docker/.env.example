# .env 示例文件
# 复制为 .env 并填写实际值：cp .env.example .env

# PostgreSQL
PG_PASSWORD=请修改为强密码
PG_DB=equipai
PG_USER=postgres
PG_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# MQTT
MQTT_PORT=1883

# JWT 密钥（至少 32 字符）
JWT_SECRET=请修改为随机密钥-至少32个字符!!

# 后端端口
BACKEND_PORT=8080

# 前端端口
FRONTEND_PORT=80

# ASP.NET 环境
ASPNETCORE_ENVIRONMENT=Production

# LLM 配置
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# VAPID 推送证书（Web Push 所需，使用 npx web-push generate-vapid-keys 生成）
VAPID__SUBJECT=mailto:admin@example.com
VAPID__PUBLICKEY=
VAPID__PRIVATEKEY=

# 域名（用于 HSTS 和 Cookie 配置）
DOMAIN=localhost

# 是否在反向代理（Nginx）之后
BEHIND_PROXY=true

# TLS 证书路径（容器内路径，通过 volume 挂载）
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 可观测性
SEQ_PORT=5341
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
