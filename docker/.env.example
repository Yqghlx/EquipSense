# .env 示例文件
# 复制为 .env 并填写实际值：cp .env.example .env
# ⚠️  所有标记为「请修改」的值必须替换，否则应用将拒绝启动或存在安全风险

# PostgreSQL — ⚠️ 必须设置强密码；不能与其他组件或种子账户复用
PG_PASSWORD=请修改为强密码
PG_DB=equipai
PG_USER=postgres
PG_PORT=5432

# Redis — ⚠️ 必须设置独立密码，留空将导致 Redis 无法启动
REDIS_PASSWORD=请修改为强密码
REDIS_PORT=6379

# MQTT
# 生产 Compose 使用 8883/TLS；开发 Compose 使用独立的 1883 明文配置
MQTT_PORT=8883
MQTT_USERNAME=请修改为MQTT用户名
MQTT_PASSWORD=请修改为强密码

# 生产种子账户密码（五个账户均必填，至少 16 个字符；彼此及与其他生产凭据均不得复用）
SEED_ADMIN_PASSWORD=请修改为管理员初始密码
SEED_LEAD_PASSWORD=请修改为主管初始密码
SEED_TECH_PASSWORD=请修改为技术员初始密码
SEED_OPERATOR_PASSWORD=请修改为操作员初始密码
SEED_VIEWER_PASSWORD=请修改为观察者初始密码
# 仅 E2E/测试环境使用；生产环境默认不创建第二租户账户
# SEED_TENANT2_ACCOUNT=false
# SEED_TENANT2_PASSWORD=

# Edge Gateway — 边缘网关配置
# ⚠️ GATEWAY_AUTH_KEY 必须与后端 Gateway:AuthKey 配置一致，且必须为纯 ASCII
# HTTP header 不允许中文字符，残留 .env 占位符会导致心跳每次都失败
GATEWAY_ID=gateway-001
# 边缘网关生产必填：使用实际租户 UUID，否则网关会拒绝启动
GATEWAY_TENANT_ID=PLEASE_CHANGE_TO_REAL_TENANT_UUID
# SQLite 断网缓冲必须落在 Compose 持久化卷中
GATEWAY_BUFFER_PATH=/data/buffer.db
# 普通部署保持默认值；蓝绿脚本会临时覆盖为 backend-blue/green 的服务地址
GATEWAY_BACKEND_URL=http://backend:8080
GATEWAY_AUTH_KEY=PLEASE_CHANGE_THIS_TO_ASCII_STRONG_KEY_AT_LEAST_32_CHARS
# 后端代理网关状态/连接测试的精确主机白名单；Docker 默认使用 edgegateway，多主机逗号分隔
GATEWAY_ALLOWED_HOSTS=edgegateway
GATEWAY_UPLOAD_INTERVAL=5
EDGE_PORT=8081
# 蓝绿部署的边缘网关健康探针宿主端口，避免与 backend-blue 的 8081 冲突
EDGE_BLUEGREEN_PORT=18081
# 生产端口绑定：数据库、缓存、事件总线和可观测性默认只监听本机；
# 前端、MQTT 和蓝绿 router 默认对外提供服务。若前面已有负载均衡器，可将 PUBLIC_BIND_ADDRESS 改为 127.0.0.1。
INTERNAL_BIND_ADDRESS=127.0.0.1
PUBLIC_BIND_ADDRESS=0.0.0.0

# JWT 密钥 — ⚠️ 至少 32 个字符的随机字符串，生产环境将校验长度
# 生成方式：openssl rand -base64 48
JWT_SECRET=请修改为随机密钥-至少32个字符!!

# 机器客户端登录响应令牌密钥（可选）。生产浏览器默认只使用 HttpOnly Cookie；
# 压测/模拟器等需要读取响应体 JWT 的客户端必须配置独立的至少 32 位随机 ASCII 密钥，
# 并通过 X-API-Key 请求头发送。不能复用 JWT、网关或数据库凭据。
# AUTH_MACHINE_API_KEY=请修改为独立的机器客户端 API 密钥

# TOTP 密钥保护 — ⚠️ AES-256 密钥，必须是 Base64 编码的 32 字节值
# 生成方式：openssl rand -base64 32；必须保存到外部密钥管理系统，不能提交到代码库
TOTP_ENCRYPTION_KEY=请修改为openssl-rand-base64-32生成的密钥

# 用户邮箱/手机号 PII 密钥保护 — ⚠️ AES-256 密钥，必须是 Base64 编码的 32 字节值
# 生成方式：openssl rand -base64 32；必须与 TOTP_ENCRYPTION_KEY 使用不同密钥
PII_ENCRYPTION_KEY=请修改为openssl-rand-base64-32生成的独立密钥

# AutoMapper 15+ 生产许可证 — 从供应商控制台获取，并通过密钥管理系统注入
AUTOMAPPER_LICENSE_KEY=PLEASE_CHANGE_AUTOMAPPER_LICENSE_KEY

# 后端端口
BACKEND_PORT=8080

# 前端端口
FRONTEND_PORT=80

# 工单附件存储。默认使用本地卷；跨主机/多副本部署才切换为 S3。
FILE_STORAGE_PROVIDER=Local
# 切换为 S3 时，必须配置桶和端点/凭据；生产自定义端点必须使用 HTTPS。
# FILE_STORAGE_PROVIDER=S3
# FILE_STORAGE_S3_BUCKET=equipsense-attachments
# FILE_STORAGE_S3_REGION=cn-shanghai
# FILE_STORAGE_S3_ENDPOINT=https://s3.example.com
# FILE_STORAGE_S3_ACCESS_KEY=
# FILE_STORAGE_S3_SECRET_KEY=
# FILE_STORAGE_S3_USE_PATH_STYLE=false
# FILE_STORAGE_S3_KEY_PREFIX=attachments
# 本地模式下必须与生产 Compose 的 attachments_data 卷挂载点一致。
FILE_STORAGE_BASE_PATH=/app/uploads

# ASP.NET 环境
ASPNETCORE_ENVIRONMENT=Production

# API 限流：生产默认启用，生产环境会忽略任何禁用限流的开关
# 默认值：普通接口 60 次/分钟、认证接口 10 次/分钟、租户总量 1000 次/分钟
# RATE_LIMITING_PERMIT_LIMIT=60
# RATE_LIMITING_AUTH_PERMIT_LIMIT=10
# RATE_LIMITING_TENANT_PERMIT_LIMIT=1000
# RATE_LIMITING_WINDOW=00:01:00

# 生产高权限 MFA 策略默认来自 appsettings.Production.json：
# SystemAdmin 和 MaintenanceLead 首次登录必须完成 TOTP 注册，不能禁用 MFA。
# 如需显式覆盖，使用 Security__Mfa__RequiredRoles__0/1，并保留这两个角色。

# LLM 配置
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# SMTP 邮件配置 — 密码重置、告警邮件通知必需
# 留空则邮件功能不可用（密码重置会降级为仅记录日志，不发邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EquipSense
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# VAPID 推送证书（Web Push 所需，使用 npx web-push generate-vapid-keys 生成）
VAPID__SUBJECT=mailto:admin@example.com
VAPID__PUBLICKEY=
VAPID__PRIVATEKEY=

# 事件总线 — 生产默认 RabbitMQ；仅在经批准的紧急降级中使用 InMemory
EVENTBUS_PROVIDER=RabbitMQ
# 仅生产事故应急时临时改为 true，并同时把 EVENTBUS_PROVIDER 改为 InMemory。
ALLOW_INMEMORY_EVENTBUS_IN_PRODUCTION=false
# 固定镜像 digest。现有 3.13 数据卷必须按运维手册经 4.2 升级，禁止直接挂载到 4.3。
RABBITMQ_IMAGE=rabbitmq:4.3.4-management-alpine@sha256:44bf7eb50fe1765885659e49ccfdc775f8e531964d979321aee380a071f49f94
# RabbitMQ 凭证必须与容器 RABBITMQ_DEFAULT_* 一致，密码至少 16 个字符且禁止 guest。
RABBITMQ_USER=equipai
RABBITMQ_PASSWORD=请修改为强密码
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# 事务 Outbox 分发参数；生产保持 Enabled=true，消息发布失败会在数据库中退避重试
EVENTBUS_OUTBOX_ENABLED=true
EVENTBUS_OUTBOX_POLL_INTERVAL_SECONDS=1
EVENTBUS_OUTBOX_BATCH_SIZE=50
EVENTBUS_OUTBOX_LEASE_SECONDS=60
EVENTBUS_OUTBOX_MAX_BACKOFF_SECONDS=300
EVENTBUS_OUTBOX_RETENTION_DAYS=7

# 域名（用于 HSTS 和 Cookie 配置）
DOMAIN=localhost

# 前端对外访问地址（用于 CORS 白名单，后端必须显式允许此域名）
# 格式：https://app.example.com 或 https://localhost（不带末尾斜杠）
FRONTEND_URL=https://localhost

# 是否在反向代理（Nginx）之后
BEHIND_PROXY=true
# 可信反向代理网段，多个网段用英文逗号分隔；默认覆盖 Docker bridge 网络。
# 如果部署平台使用自定义网段，请改成实际 Nginx/Ingress 出口网段。
TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# AI 评估标准答案上报（生产默认关闭，仅内部评估任务按需开启）
# 开启时必须同时设置至少 32 位 API Key 和固定租户 ID；不要复用 JWT、网关或 RabbitMQ 密钥。
EVALUATION_ALLOW_GROUND_TRUTH_INGESTION=false
# EVALUATION_INGESTION_API_KEY=
# EVALUATION_TENANT_ID=

# 出站集成默认拒绝 RFC1918 私网地址，避免 Webhook/EAM 配置把服务变成 SSRF 代理。
# 只有 EAM/Webhook 明确位于企业内网时才设为 true，并同时限制数据库/网络访问权限。
OUTBOUND_HTTP_ALLOW_PRIVATE_NETWORKS=false

# TLS 证书路径（容器内路径，通过 volume 挂载）
# ⚠️  安全警告：生产首次部署前必须预置 CA 签发的证书；docker/setup.sh 只校验生产证书，
# 不会自动生成自签名证书。开发/测试环境可单独运行 generate-cert.sh 和 generate-mqtt-cert.sh。
# 仓库【不再】内置任何证书或私钥（历史版本曾误传，已移除并加入 .gitignore）。
# 自签名证书仅适用于开发/测试，HTTPS 流量无中间人防护。
# 请务必替换为自己的证书：
#   1. 开发/测试：cd docker && ./generate-cert.sh <你的域名或IP>
#      会生成你专属的自签名证书（CN=你的域名）
#   2. 生产环境（推荐）：使用 Let's Encrypt 免费证书
#      certbot certonly --standalone -d your-domain.com
#      然后设置：
#        SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
#        SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
#   3. 或购买商业 SSL 证书，挂载到容器后修改下面的路径
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 可观测性 — ⚠️ Grafana 默认密码必须修改
SEQ_PORT=5341
# Seq 管理员密码 — 生产环境必填，禁止使用公开默认值
SEQ_ADMIN_PASSWORD=请修改为强密码
# Seq 日志保留天数（默认 30d，格式：数字+单位，如 7d/30d/90d）
# SEQ_RETENTION_TIME=30d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=请修改Grafana密码
ALERTMANAGER_PORT=9093
# Jaeger 单机生产默认使用持久化 Badger；多副本部署请切换到外部 OpenSearch/Tempo。
JAEGER_SPAN_STORAGE_TYPE=badger
JAEGER_BADGER_EPHEMERAL=false
# Alertmanager 外部通知 Webhook（可选）。未配置时告警仍会在 Alertmanager/Grafana 中保留，
# 但不会发送到外部渠道；生产环境请填写企业内部或受信任的 HTTPS 地址。
# ALERT_WEBHOOK_URL=https://alert-receiver.example.com/api/alertmanager

# ============================================================
# 备份配置（backup.sh 使用）
# ============================================================
# 备份目录（默认 ./docker/backups）
# BACKUP_DIR=./backups
# 备份保留天数（默认 7）
# RETAIN_DAYS=7
# 是否备份 Redis（默认 true，需要配置 REDIS_PASSWORD）
# BACKUP_REDIS=true
# Redis 容器名（默认 equipai-redis）
# REDIS_CONTAINER=equipai-redis
# 是否备份工单附件（默认 true；需要后端容器和 /app/uploads 可访问）
BACKUP_ATTACHMENTS=true
# 附件所在容器和容器内路径（通常无需修改）
# ATTACHMENTS_CONTAINER=equipai-backend
# ATTACHMENTS_PATH=/app/uploads
# 是否同步到 S3/OSS（默认 false；开启后必须配置 S3_BUCKET 并安装 aws-cli，
# 缺少目标、工具或同步失败都会让备份以非零状态退出，避免误报成功）
# S3_SYNC=false
# S3 桶地址（如 s3://my-bucket/equipsense-backups/）
# S3_BUCKET=
# 备份完成通知 webhook（钉钉/飞书机器人）
# BACKUP_WEBHOOK=
