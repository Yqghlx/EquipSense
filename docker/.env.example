# .env 示例文件
# 复制为 .env 并填写实际值：cp .env.example .env
# ⚠️  所有标记为「请修改」的值必须替换，否则应用将拒绝启动或存在安全风险

# PostgreSQL — ⚠️ 必须设置强密码
PG_PASSWORD=请修改为强密码
PG_DB=equipai
PG_USER=postgres
PG_PORT=5432

# Redis — ⚠️ 必须设置密码，留空将导致 Redis 无法启动
REDIS_PASSWORD=请修改为强密码
REDIS_PORT=6379

# MQTT
# 生产 Compose 使用 8883/TLS；开发 Compose 使用独立的 1883 明文配置
MQTT_PORT=8883
MQTT_USERNAME=请修改为MQTT用户名
MQTT_PASSWORD=请修改为强密码

# 生产种子账户密码（五个账户均必填，禁止使用仓库中的公开默认值）
SEED_ADMIN_PASSWORD=请修改为管理员初始密码
SEED_LEAD_PASSWORD=请修改为主管初始密码
SEED_TECH_PASSWORD=请修改为技术员初始密码
SEED_OPERATOR_PASSWORD=请修改为操作员初始密码
SEED_VIEWER_PASSWORD=请修改为观察者初始密码
# 仅 E2E/测试环境使用；生产环境默认不创建第二租户账户
# SEED_TENANT2_ACCOUNT=false
# SEED_TENANT2_PASSWORD=

# Edge Gateway — 边缘网关配置
# ⚠️ GATEWAY_AUTH_KEY 必须与后端 Gateway:AuthKey 配置一致，且必须为纯 ASCII
# HTTP header 不允许中文字符，残留 .env 占位符会导致心跳每次都失败
GATEWAY_ID=gateway-001
GATEWAY_TENANT_ID=
GATEWAY_AUTH_KEY=PLEASE_CHANGE_THIS_TO_ASCII_STRONG_KEY_AT_LEAST_32_CHARS
GATEWAY_UPLOAD_INTERVAL=5
EDGE_PORT=8081

# JWT 密钥 — ⚠️ 至少 32 个字符的随机字符串，生产环境将校验长度
# 生成方式：openssl rand -base64 48
JWT_SECRET=请修改为随机密钥-至少32个字符!!

# 后端端口
BACKEND_PORT=8080

# 前端端口
FRONTEND_PORT=80

# ASP.NET 环境
ASPNETCORE_ENVIRONMENT=Production

# LLM 配置
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# SMTP 邮件配置 — 密码重置、告警邮件通知必需
# 留空则邮件功能不可用（密码重置会降级为仅记录日志，不发邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EquipSense
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# VAPID 推送证书（Web Push 所需，使用 npx web-push generate-vapid-keys 生成）
VAPID__SUBJECT=mailto:admin@example.com
VAPID__PUBLICKEY=
VAPID__PRIVATEKEY=

# 事件总线 — 默认进程内（InMemory），设为 RabbitMQ 启用持久化事件总线
# RabbitMQ 提供持久化 + 重试 + 死信队列，进程重启不丢业务事件（告警/工单/分析）
# 启用后 backend 会依赖 rabbitmq 服务；未启用时 rabbitmq 服务虽启动但无消费者
EVENTBUS_PROVIDER=InMemory
# RabbitMQ 凭证（EVENTBUS_PROVIDER=RabbitMQ 时必填，与 rabbitmq 服务 RABBITMQ_DEFAULT_* 一致）
RABBITMQ_USER=equipai
RABBITMQ_PASSWORD=请修改为强密码
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 域名（用于 HSTS 和 Cookie 配置）
DOMAIN=localhost

# 前端对外访问地址（用于 CORS 白名单，后端必须显式允许此域名）
# 格式：https://app.example.com 或 http://localhost:8443（不带末尾斜杠）
FRONTEND_URL=http://localhost:8443

# 是否在反向代理（Nginx）之后
BEHIND_PROXY=true

# TLS 证书路径（容器内路径，通过 volume 挂载）
# ⚠️  安全警告：首次部署前必须运行 docker/setup.sh，它会生成专属自签名证书。
# 仓库【不再】内置任何证书或私钥（历史版本曾误传，已移除并加入 .gitignore）。
# 自签名证书仅适用于开发/测试，HTTPS 流量无中间人防护。
# 请务必替换为自己的证书：
#   1. 开发/测试：cd docker && ./generate-cert.sh <你的域名或IP>
#      会生成你专属的自签名证书（CN=你的域名）
#   2. 生产环境（推荐）：使用 Let's Encrypt 免费证书
#      certbot certonly --standalone -d your-domain.com
#      然后设置：
#        SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
#        SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
#   3. 或购买商业 SSL 证书，挂载到容器后修改下面的路径
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 可观测性 — ⚠️ Grafana 默认密码必须修改
SEQ_PORT=5341
# Seq 日志保留天数（默认 30d，格式：数字+单位，如 7d/30d/90d）
# SEQ_RETENTION_TIME=30d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=请修改Grafana密码
ALERTMANAGER_PORT=9093

# ============================================================
# 备份配置（backup.sh 使用）
# ============================================================
# 备份目录（默认 ./docker/backups）
# BACKUP_DIR=./backups
# 备份保留天数（默认 7）
# RETAIN_DAYS=7
# 是否备份 Redis（默认 true，需要配置 REDIS_PASSWORD）
# BACKUP_REDIS=true
# 是否同步到 S3/OSS（默认 false，需要安装 aws-cli）
# S3_SYNC=false
# S3 桶地址（如 s3://my-bucket/equipsense-backups/）
# S3_BUCKET=
# 备份完成通知 webhook（钉钉/飞书机器人）
# BACKUP_WEBHOOK=
