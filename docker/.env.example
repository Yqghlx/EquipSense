# .env 示例文件
# 复制为 .env 并填写实际值：cp .env.example .env

# PostgreSQL
PG_PASSWORD=请修改为强密码
PG_DB=equipai
PG_USER=postgres
PG_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# MQTT
MQTT_PORT=1883

# JWT 密钥（至少 32 字符）
JWT_SECRET=请修改为随机密钥-至少32个字符!!

# 后端端口
BACKEND_PORT=8080

# 前端端口
FRONTEND_PORT=80

# ASP.NET 环境
ASPNETCORE_ENVIRONMENT=Production

# LLM 配置
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
