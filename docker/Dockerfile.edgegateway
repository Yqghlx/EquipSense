# 阶段1：构建
FROM mcr.microsoft.com/dotnet/sdk:8.0@sha256:e2f26f26169fd10d6f1b426e01c97397717b32e9d5ab4ee4a7d5497ed9403007 AS build
WORKDIR /src

# 继承仓库锁定的 SDK 和构建警告策略，确保边缘网关与主后端使用同一编译基线。
COPY global.json Directory.Build.props ./

# 先复制项目文件并还原依赖（利用 Docker 层缓存）。EdgeGateway 依赖 Core，两个项目文件都必须存在。
COPY src/EquipAI.Core/EquipAI.Core.csproj EquipAI.Core/
COPY src/EquipAI.EdgeGateway/EquipAI.EdgeGateway.csproj EquipAI.EdgeGateway/
RUN dotnet restore EquipAI.EdgeGateway/EquipAI.EdgeGateway.csproj

# 复制完整源码并构建
COPY src/EquipAI.Core/ EquipAI.Core/
COPY src/EquipAI.EdgeGateway/ EquipAI.EdgeGateway/
RUN dotnet publish EquipAI.EdgeGateway/EquipAI.EdgeGateway.csproj \
    -c Release -o /app/publish --no-restore

# 阶段2：运行
FROM mcr.microsoft.com/dotnet/runtime:8.0@sha256:794b603ad8cf882df3a37dcb124eccdcd688c367864cd66e93e921cda9caba76 AS runtime
WORKDIR /app

# 安装 ICU 库（中文等 Unicode 排序所需）
RUN apt-get update && apt-get install -y --no-install-recommends libicu-dev curl \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户运行应用
RUN groupadd -r equipai && useradd -r -g equipai equipai

COPY --from=build /app/publish .

# 创建 SQLite 数据目录
RUN mkdir -p /data && chown -R equipai:equipai /app /data

ENV DOTNET_System_Globalization_Invariant=false

# 切换到非 root 用户
USER equipai

# 健康检查和 Prometheus 指标端口
EXPOSE 8081

ENTRYPOINT ["dotnet", "EquipAI.EdgeGateway.dll"]
