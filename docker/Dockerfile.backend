# 阶段1：构建
FROM mcr.microsoft.com/dotnet/sdk:8.0@sha256:e2f26f26169fd10d6f1b426e01c97397717b32e9d5ab4ee4a7d5497ed9403007 AS build
WORKDIR /src

# 先复制项目文件并还原依赖（利用 Docker 层缓存）
COPY src/EquipAI.Core/EquipAI.Core.csproj EquipAI.Core/
COPY src/EquipAI.Application/EquipAI.Application.csproj EquipAI.Application/
COPY src/EquipAI.Infrastructure/EquipAI.Infrastructure.csproj EquipAI.Infrastructure/
COPY src/EquipAI.WebAPI/EquipAI.WebAPI.csproj EquipAI.WebAPI/
RUN dotnet restore EquipAI.WebAPI/EquipAI.WebAPI.csproj

# 复制完整源码并构建
COPY src/ ./
RUN dotnet publish EquipAI.WebAPI/EquipAI.WebAPI.csproj \
    -c Release -o /app/publish

# 阶段2：运行
FROM mcr.microsoft.com/dotnet/aspnet:8.0@sha256:fd7596eaea7ad453fe7ac16724a3c9ae36edcda894ba13743d6a5c83d6a3b36d AS runtime
WORKDIR /app

# 安装 ICU 库（中文等 Unicode 排序所需）、netcat（等待 PG 就绪）、curl（健康检查）
RUN apt-get update && apt-get install -y --no-install-recommends libicu-dev netcat-openbsd curl \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户运行应用
RUN groupadd -r equipai && useradd -r -g equipai equipai

COPY --from=build /app/publish .

# 设置文件所有权
RUN mkdir -p /app/uploads \
    && chown -R equipai:equipai /app

# 复制启动脚本（等待 PG 就绪 + 自动迁移准备）
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chown equipai:equipai /app/entrypoint.sh

ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_System_Globalization_Invariant=false

# 切换到非 root 用户
USER equipai

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
